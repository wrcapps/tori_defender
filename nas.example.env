# Copy this file to nas.env and edit it, then run ./install.sh -- it will
# pick these settings up automatically. If you skip this file entirely,
# install.sh just uses the defaults below.
#
# Your NAS username and password are NEVER put in a file. install.sh always
# asks for them interactively, so they never end up in git, in this file, or
# in shell history.

# Address of the NAS and the shared folder on it.
TORI_HOST=192.168.1.138
TORI_SHARE=Pasari

# Where to mount it on this machine.
MOUNT_POINT=/mnt/Tori
